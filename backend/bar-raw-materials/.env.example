# Copy to .env (same folder) and fill in real values. Never commit .env.
# Spring Boot loads this file via spring.config.import; real environment variables take precedence.

# --- Database ---
DB_URL=jdbc:mysql://localhost:3306/bar_materials_db?useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=bar_app
DB_PASSWORD=change-me

# Only used by docker-compose.yml to initialise the MySQL container
DB_NAME=bar_materials_db
MYSQL_ROOT_PASSWORD=change-me-too

# --- Security ---
# Base64-encoded key, at least 32 bytes once decoded. Generate with: openssl rand -base64 32
JWT_SECRET_KEY=replace-with-output-of-openssl-rand-base64-32

# --- Server ---
SERVER_PORT=8080
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Folder for uploaded images (relative to the backend working directory or absolute)
IMAGE_PATH=./images/
